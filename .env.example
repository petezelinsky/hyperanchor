# openssl rand -base64 32  (or: npx auth secret). Also signs the iOS app's bearer tokens.
AUTH_SECRET=

# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: https://hyperanchor.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# OAuth client ID of type iOS (bundle ID app.hyperanchor): accepted as the audience of the app's Google ID tokens
GOOGLE_IOS_CLIENT_ID=

# Sign in with Apple (Apple Developer → Certificates, Identifiers & Profiles). All optional: without them the
# web shows Google only, and the iOS app's Apple sign-in still works (it needs only APPLE_BUNDLE_ID).
# Web: a Services ID, return URL https://hyperanchor.app/api/auth/callback/apple
AUTH_APPLE_ID=
# The iOS app's bundle ID (default app.hyperanchor)
APPLE_BUNDLE_ID=app.hyperanchor
# A Sign in with Apple key (.p8): signs client secrets for the web and for revoking tokens on account deletion
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Instead of a key, the web can use a pre-generated client secret (npx auth add apple; expires after 6 months)
AUTH_APPLE_SECRET=

# Postgres connection string (Neon / Supabase / any Postgres)
DATABASE_URL=postgres://user:password@host:5432/dbname
